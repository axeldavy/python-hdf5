"""Public interface for the native HDF5 extension."""

from collections.abc import Callable, Iterator
from os import PathLike
from typing import Any, Literal, NamedTuple
from types import EllipsisType, TracebackType

import numpy as np
import numpy.typing as npt

class AttributeManager:
    """Access numeric and string attributes on a file, group, or dataset."""

    def create(
        self, name: str | bytes, data: npt.ArrayLike, shape: int | tuple[int, ...] | None = None,
        dtype: npt.DTypeLike | None = None,
    ) -> None: ...
    def keys(self) -> list[str | bytes]: ...
    def __getitem__(self, name: str | bytes) -> np.generic | npt.NDArray: ...
    def __setitem__(self, name: str | bytes, value: npt.ArrayLike) -> None: ...
    def __delitem__(self, name: str | bytes) -> None: ...
    def __contains__(self, name: str | bytes) -> bool: ...
    def __iter__(self) -> Iterator[str]: ...
    def __len__(self) -> int: ...

class StringInfo(NamedTuple):
    """Describe a string dtype by encoding and fixed length (None if variable)."""

    encoding: str
    length: int | None

def string_dtype(encoding: str = "utf-8", length: int | None = None) -> np.dtype: ...
def check_string_dtype(dtype: npt.DTypeLike) -> StringInfo | None: ...
def vlen_dtype(basetype: npt.DTypeLike) -> np.dtype: ...
def check_vlen_dtype(dtype: npt.DTypeLike) -> type | np.dtype | None: ...
def enum_dtype(values_dict: dict[str, int], basetype: npt.DTypeLike = ...) -> np.dtype: ...
def check_enum_dtype(dtype: npt.DTypeLike) -> dict[str, int] | None: ...
def opaque_dtype(dtype: npt.DTypeLike) -> np.dtype: ...
def check_opaque_dtype(dtype: npt.DTypeLike) -> bool: ...

class _ReadAdapter:
    """Read-only converting view of a dataset."""

    @property
    def dtype(self) -> np.dtype: ...
    @property
    def shape(self) -> tuple[int, ...]: ...
    def __getitem__(
        self, selection: int | slice | EllipsisType | tuple[int | slice | EllipsisType, ...]
    ) -> Any: ...
    def __len__(self) -> int: ...

class Dataset:
    """Access a numeric or string dataset."""

    @property
    def attrs(self) -> AttributeManager: ...
    @property
    def shape(self) -> tuple[int, ...]: ...
    @property
    def dtype(self) -> np.dtype: ...
    @property
    def name(self) -> str | bytes: ...
    @property
    def parent(self) -> Group: ...
    @property
    def file(self) -> File: ...
    def __len__(self) -> int: ...
    def asstr(self, encoding: str | None = None, errors: str = "strict") -> _ReadAdapter: ...
    def astype(self, dtype: npt.DTypeLike) -> _ReadAdapter: ...
    def read(self) -> np.generic | npt.NDArray: ...
    def flush(self) -> None: ...
    def refresh(self) -> None: ...
    def resize(self, size: int | tuple[int, ...], axis: int | None = None) -> None: ...
    def write(self, value: npt.ArrayLike) -> None: ...
    def __getitem__(
        self, selection: int | slice | EllipsisType | tuple[int | slice | EllipsisType, ...]
    ) -> np.generic | npt.NDArray: ...
    def __setitem__(
        self, selection: int | slice | EllipsisType | tuple[int | slice | EllipsisType, ...],
        value: npt.ArrayLike,
    ) -> None: ...

class Group:
    """Access groups and links in an HDF5 file."""

    @property
    def attrs(self) -> AttributeManager: ...
    @property
    def name(self) -> str | bytes: ...
    @property
    def parent(self) -> Group: ...
    @property
    def file(self) -> File: ...
    def create_group(self, name: str | bytes) -> Group: ...
    def require_group(self, name: str | bytes) -> Group: ...
    def create_dataset(
        self, name: str | bytes, shape: int | tuple[int, ...] | None = None,
        dtype: npt.DTypeLike | None = None, data: npt.ArrayLike | None = None, *,
        chunks: bool | tuple[int, ...] | None = None,
        maxshape: int | tuple[int | None, ...] | None = None,
        compression: Literal["gzip"] | None = None, compression_opts: int | None = None,
        shuffle: bool = False, fletcher32: bool = False, fillvalue: object = None,
    ) -> Dataset: ...
    def require_dataset(
        self, name: str | bytes, shape: int | tuple[int, ...] | None = None,
        dtype: npt.DTypeLike | None = None, *, data: npt.ArrayLike | None = None,
        exact: bool = False, **options: Any,
    ) -> Dataset: ...
    def create_dataset_like(
        self, name: str | bytes, source: Dataset, *, dtype: npt.DTypeLike | None = None
    ) -> Dataset: ...
    def keys(self) -> list[str | bytes]: ...
    def items(self) -> list[tuple[str | bytes, Group | Dataset]]: ...
    def values(self) -> list[Group | Dataset]: ...
    def get(self, name: str | bytes, default: Any = None) -> Any: ...
    def __getitem__(self, name: str | bytes) -> Group | Dataset: ...
    def __delitem__(self, name: str | bytes) -> None: ...
    def __contains__(self, name: str | bytes) -> bool: ...
    def __iter__(self) -> Iterator[str | bytes]: ...
    def __len__(self) -> int: ...

class File(Group):
    """Own an HDF5 file and close it explicitly or on context exit."""

    def __init__(
        self, filename: str | bytes | PathLike[str] | PathLike[bytes], mode: str = "r", *,
        driver: Literal["core"] | None = None,
        backing_store: bool | None = None,
        block_size: int | None = None,
        libver: str | tuple[str, str] | None = None,
        rdcc_nslots: int | None = None,
        rdcc_nbytes: int | None = None,
        rdcc_w0: float | None = None,
        locking: bool | Literal["true", "false", "best-effort"] | None = None,
        swmr: bool = False,
    ) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def parent(self) -> File: ...
    @property
    def closed(self) -> bool: ...
    @property
    def swmr_mode(self) -> bool: ...
    @swmr_mode.setter
    def swmr_mode(self, value: bool) -> None: ...
    def close(self) -> None: ...
    @property
    def file(self) -> File: ...
    def flush(self) -> None: ...
    def __enter__(self) -> File: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc_value: BaseException | None,
        traceback: TracebackType | None,
    ) -> None: ...
